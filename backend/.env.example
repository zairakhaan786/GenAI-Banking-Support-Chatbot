# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="GenAI Banking Support Chatbot"
DEBUG=false
LOG_LEVEL=INFO

# ── LLM Provider ───────────────────────────────────────────────────────────────
# Options: groq | openai | google | fallback
# "fallback" works without any API key using smart context formatting
LLM_PROVIDER=groq

# ── API Keys (provide at least one for full LLM capability) ───────────────────
# Groq — fast, free tier: https://console.groq.com
GROQ_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── Model Selection (optional – defaults are optimal) ─────────────────────────
GROQ_MODEL=llama3-8b-8192
OPENAI_MODEL=gpt-3.5-turbo
GOOGLE_MODEL=gemini-1.5-flash

# ── RAG Settings ───────────────────────────────────────────────────────────────
TOP_K_RESULTS=5
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# ── Embeddings ─────────────────────────────────────────────────────────────────
# Local model — no API key needed
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=banking_knowledge_base

# ── Session ────────────────────────────────────────────────────────────────────
MAX_HISTORY_TURNS=8
SESSION_EXPIRY_MINUTES=60

# ── File Upload ────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./uploads
