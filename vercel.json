{
  "version": 2,
  "name": "genai-banking-chatbot",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "env": {
    "LLM_PROVIDER": "fallback",
    "DEBUG": "false",
    "LOG_LEVEL": "INFO",
    "CHROMA_PERSIST_DIR": "/tmp/chroma_db",
    "UPLOAD_DIR": "/tmp/uploads",
    "LOG_FILE": "/tmp/app.log"
  }
}
